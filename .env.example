# SpeechCortex SDK configuration
# Copy to .env and fill in, or export the variables directly.

SPEECHCORTEX_API_KEY=your-api-key
SPEECHCORTEX_HOST=wss://api.speechcortex.ai

# Optional overrides
# SPEECHCORTEX_REALTIME_PATH=/transcribe/realtime
# SPEECHCORTEX_BATCH_PATH=/api/v1/transcription
# SPEECHCORTEX_LOGGING=DEBUG
